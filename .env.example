# Development only: local MongoDB started with `docker compose up -d mongodb`.
MONGODB_URI=mongodb://localhost:27017/itsunikki

# Server-only: set this to the Supabase project's Auth issuer. Never expose it in the browser.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Browser-visible development configuration. VITE_* values are public by design.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_BASE_URL=http://localhost:3001/v1

# Render production environment (configure in Render; do not put real values in this file):
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://<render-db-user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# SUPABASE_JWT_ISSUER=https://<supabase-project-ref>.supabase.co/auth/v1
# WEB_ORIGIN=https://<vercel-production-domain>

# Vercel production environment (configure in Vercel; these values are public):
# VITE_SUPABASE_URL=https://<supabase-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
# VITE_API_BASE_URL=https://<render-service>.onrender.com/v1
