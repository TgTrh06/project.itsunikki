# Local MongoDB, started with: docker compose up -d mongodb
MONGODB_URI=mongodb://localhost:27017/itsunikki

# Supabase development project. Never expose SUPABASE_JWT_ISSUER in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
